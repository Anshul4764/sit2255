import dash
from dash import dcc, html
from dash.dependencies import Input, Output
import pandas as pd
import plotly.express as px

# Load the CSV file (Make sure the file path is correct)
file_path = r"D:\chitkara\Programingcodes\sit225\new1.py\gyroscope_data.csv"  # Use raw string
df = pd.read_csv(file_path)

# Ensure timestamp column exists and convert it
if "timestamp" in df.columns:
    df["timestamp"] = pd.to_datetime(df["timestamp"], unit="ms")  # Assuming milliseconds
else:
    raise KeyError("Column 'timestamp' not found in the dataset.")

# Initialize Dash app
app = dash.Dash(__name__)

# Layout of the dashboard
app.layout = html.Div([
    html.H1("Gyroscope Data Dashboard", style={'textAlign': 'center', 'fontWeight': 'bold'}),

    # Dropdown to select which axis to visualize
    html.Label("Select Variables:"),
    dcc.Checklist(
        id="axis-selector",
        options=[
            {"label": "X-Axis", "value": "x"},
            {"label": "Y-Axis", "value": "y"},
            {"label": "Z-Axis", "value": "z"}
        ],
        value=["x", "y", "z"],  # Default selected values
        inline=True
    ),

    # Graph to display data
    dcc.Graph(id="gyroscope-graph")
])

# Callback to update the graph
@app.callback(
    Output("gyroscope-graph", "figure"),
    [Input("axis-selector", "value")]
)
def update_graph(selected_axes):
    if not selected_axes:
        return px.line(title="Select at least one variable to display.")

    fig = px.line(df, x="timestamp", y=selected_axes, title="Gyroscope Data Over Time")
    fig.update_layout(xaxis_title="Timestamp", yaxis_title="Value")
    
    return fig

# Run the Dash app
if __name__ == "__main__":
    app.run_server(debug=True)
